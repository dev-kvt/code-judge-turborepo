{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["DATABASE_URL", "GEMINI_API", "GROQ", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "AWS_REGION", "S3_BUCKET_NAME"],
  "tasks": {
    "build": {
      "dependsOn": [ "^db:generate","^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "dev": {
      "cache": false,
      "dependsOn": ["^db:pushschema", "^db:generate"],
      "persistent": true
    },
    "db:pushschema": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
